{
  "redirects": [
    { "source": "/contactus", "destination": "/ContactUs", "permanent": true },
    { "source": "/contact-us", "destination": "/ContactUs", "permanent": true }
  ],
  "rewrites": [
    { "source": "/api/(.*)", "destination": "/api/$1" },
    { "source": "/(.*)", "destination": "/index.html" }
  ]
}
